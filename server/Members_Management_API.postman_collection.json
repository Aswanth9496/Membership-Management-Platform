	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-login if not authenticated",
					"if (!pm.globals.get(\"adminLoggedIn\") && pm.info.requestName === \"Admin Login\") {",
					"    // Let the login request proceed",
					"    return;",
					"}",
					"",
					"// Check if we need to login before making requests",
					"if (!pm.globals.get(\"adminLoggedIn\") && pm.info.requestName !== \"Admin Login\") {",
					"    console.log(\"Need to login first\");",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Common tests for all requests",
					"pm.test(\"Status code is successful\", function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
					"});",
					"",
					"pm.test(\"Response has success field\", function () {",
					"    const responseJson = pm.response.json();",
					"    pm.expect(responseJson).to.have.property('success');",
					"});",
					"",
					"pm.test(\"Response time is reasonable\", function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(3000);",
					"});",
					"",
					"// Specific tests for GET members endpoints",
					"if (pm.info.requestName.includes(\"Get Members\")) {",
					"    pm.test(\"Members response structure\", function () {",
					"        const responseJson = pm.response.json();",
					"        if (responseJson.success) {",
					"            pm.expect(responseJson.data).to.have.property('members');",
					"            pm.expect(responseJson.data).to.have.property('pagination');",
					"            pm.expect(responseJson.data.pagination).to.have.property('currentPage');",
					"            pm.expect(responseJson.data.pagination).to.have.property('totalPages');",
					"            pm.expect(responseJson.data.pagination).to.have.property('totalMembers');",
					"        }",
					"    });",
					"}",
					"",
					"// Specific tests for status update endpoints",
					"if (pm.info.requestName.includes(\"Update Member Status\")) {",
					"    pm.test(\"Status update response\", function () {",
					"        const responseJson = pm.response.json();",
					"        if (responseJson.success) {",
					"            pm.expect(responseJson.data).to.have.property('newStatus');",
					"            pm.expect(responseJson.data).to.have.property('changedBy');",
					"        }",
					"    });",
					"}"
				]
			}
		}
