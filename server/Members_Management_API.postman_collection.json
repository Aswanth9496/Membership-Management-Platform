			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store token for subsequent requests",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        // Note: Token is stored in httpOnly cookie by backend",
									"        // Postman will automatically handle cookies",
									"        pm.globals.set(\"adminLoggedIn\", true);",
									"        pm.globals.set(\"adminEmail\", response.data.admin.email);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"aswanth@gmail.com\",\n    \"password\": \"your_password_here\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"login"
							]
						}
					},
					"response": []
				}
			]
